# Compiled class file
*.class

# Log file
*.log
databricks_jdbc.log.*
logs/

#ignore entire jmeter installation (downloaded via setup script)
apache-jmeter-5.6.3/

#ignore reports
reports

#ignore data files - As it might have sensitive info
data_files/

#ignore connection properties as it might have sensitive info
connection_properties/*.properties

#ignore Test Plan auto created backup file
Test-Plans/*_backup_20*

#ignore backups directory
backups/

#ignore any backup files anywhere
*.backup_*

# IDE and system files
.DS_Store
.idea/
.vscode/
.claude/

# Python cache
__pycache__/
*.pyc
*.pyo

# Test input files (environment-specific)
test_inputs/*.txt
!test_inputs/*_template.txt
!test_inputs/*_sequential.txt

# Test suite files (user-created, may reference real connections)
test_suites/*.env
!test_suites/sample_*.env

# Test properties CSV files (environment-specific data)
test_properties/*.csv

# JDBC driver JARs
jdbc_drivers/*.jar

# Kantar test data
kantar/
kantar.tar

# Metadata backups (environment-specific)
metadata_files_backup_*/
metadata_files_old_*/

# Comparison runs (temporary analysis)
compare_runs/
/comparison_*.md

# JDBC driver backups
apache-jmeter-5.6.3/lib/ext/*.jar.old


# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# MacOS
.DS_Store
.AppleDouble
.LSOverride
