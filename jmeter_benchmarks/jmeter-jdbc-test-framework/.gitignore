# Compiled class file
*.class

# Log file
*.log
databricks_jdbc.log.*
logs/

#ignore entire jmeter installation (downloaded via setup script)
apache-jmeter-5.6.3/

#ignore reports
reports

#ignore data files - As it might have sensitive info
data_files/

#ignore connection properties as it might have sensitive info
connection_properties/*.properties

#ignore Test Plan auto created backup file
Test-Plans/*_backup_20*

#ignore backups directory
backups/

#ignore any backup files anywhere
*.backup_*

# IDE and system files
.DS_Store
.idea/
.vscode/
.claude/

# Python cache
__pycache__/
*.pyc
*.pyo
ui/*.db
ui/*.db-shm
ui/*.db-wal
ui/system_settings.json
config/system_settings.json
.venv/
.benchmark-ui.env

# Test config files (user-created, may reference real connections)
test_configs/*.env
!test_configs/sample_*.env

# Test config template files (environment-specific)
test_configs/*.txt
!test_configs/*_template.txt
!test_configs/*_sequential.txt

# Test properties CSV files (environment-specific data)
test_properties/*.csv
test_properties/ui_*.properties
metadata_files/ui_*.txt
suite_manifests/ui_*.json
suite_manifests/s3_*.json
test_properties/suite_cache/
# ...except the load-profile examples. The two profile-driven plans fall back to
# load_profile.csv / utg_load_profile.csv when LOAD_PROFILE is unset, so without
# these a fresh clone cannot run either plan. They hold only shape numbers.
!test_properties/load_profile.csv
!test_properties/utg_load_profile.csv
!test_properties/load_profile_5min.csv
!test_properties/utg_load_profile_5min.csv

# JDBC driver JARs
jdbc_drivers/*.jar

# Customer-specific test data
kantar/
kantar.tar

# Metadata backups (environment-specific)
metadata_files_backup_*/
metadata_files_old_*/

# Comparison runs (temporary analysis)
compare_runs/
/comparison_*.md

# JDBC driver backups
apache-jmeter-5.6.3/lib/ext/*.jar.old


# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# MacOS
.DS_Store
.AppleDouble
.LSOverride
