# Copy to connection_properties/redshift_connection.properties and replace placeholders.
# Install the driver and authentication dependencies first; see docs/jdbc-engines.md.
ENGINE=redshift
DRIVER_CLASS=com.amazon.redshift.jdbc.Driver
CONNECTION_STRING=jdbc:redshift://YOUR_ENDPOINT:5439/YOUR_DATABASE?ssl=true
USER=YOUR_USER
PASSWORD=YOUR_PASSWORD
JDBC_INIT_SQL=SET enable_result_cache_for_session TO OFF
