# Copy to connection_properties/fabric_connection.properties and replace placeholders.
# Install the driver and authentication dependencies first; see docs/jdbc-engines.md.
ENGINE=fabric
DRIVER_CLASS=com.microsoft.sqlserver.jdbc.SQLServerDriver
