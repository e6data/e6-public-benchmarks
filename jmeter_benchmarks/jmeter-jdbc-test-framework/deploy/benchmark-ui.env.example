# Copy to /etc/e6-benchmark-ui.env and protect with chmod 600.
# Generate with: openssl rand -hex 32
BENCHMARK_UI_TOKEN=replace-with-a-long-random-token

# Persistent registry location. JMeter artifacts remain under reports/.
BENCHMARK_UI_DB=/var/lib/e6-benchmark-ui/benchmark_ui.db

# Optional shared registry. Leave blank for SQLite. Install requirements-ui.txt
# before enabling. Supply the password through the service secret environment.
# BENCHMARK_UI_DATABASE_URL=postgresql://benchmark_ui:password@postgres:5432/benchmark_ui

# Optional JMeter Prometheus exporter. Prometheus scrapes the load-generator;
# PROMETHEUS_URL and GRAFANA_URL are navigation links shown by the UI.
PROMETHEUS_ENABLED=false
PROMETHEUS_IP=0.0.0.0
PROMETHEUS_PORT=9270
PROMETHEUS_DELAY=15
PROMETHEUS_URL=http://localhost:9090
GRAFANA_URL=http://localhost:3000/d/jmeter-prom/jmeter-performance?orgId=1

# Administrator-owned result defaults. These apply to every UI run and are
# read-only in the browser unless admin-write mode is explicitly enabled.
GENERATE_DASHBOARD=true
BENCHMARK_UI_COPY_TO_S3=false
S3_REPORT_PATH=s3://your-bucket/jmeter-results

# Optional browser editor for non-secret system defaults. Keep false for a
# read-only settings page. In production, enable only with BENCHMARK_UI_TOKEN
# and restricted network access. Database/auth/AWS secrets remain restart-only.
BENCHMARK_UI_ALLOW_SETTINGS_WRITE=false
BENCHMARK_UI_SETTINGS_FILE=/var/lib/e6-benchmark-ui/system_settings.json

# Retention is reported by the UI for administrator visibility. Cleanup stays
# disabled until an S3 upload marker has been verified.
BENCHMARK_UI_REPORT_RETENTION_DAYS=30
BENCHMARK_UI_MAX_LOCAL_REPORT_GB=100
BENCHMARK_UI_DELETE_LOCAL_AFTER_S3=false
