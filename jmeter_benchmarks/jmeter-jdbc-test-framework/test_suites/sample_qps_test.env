# Sample test suite — constant QPS test
# Usage: ./run_test.sh test_suites/sample_qps_test.env
#
# Copy this file and change only what you need between runs.

# Required: file paths
CONNECTION_FILE=connection_properties/sample_connection.properties
TEST_PLAN=Test-Plans/Test-Plan-Constant-QPS-On-Arrivals-JSR-Optimized.jmx
QUERY_FILE=data_files/sample_jmeter_queries.csv

# Optional: metadata for S3 upload
# METADATA_FILE=metadata_files/e6data_s-2x2_metadata.txt

# Test parameters
QPS=5
HOLD_PERIOD=300
RANDOM_ORDER=false
RECYCLE_ON_EOF=true

# S3 upload (default: disabled)
COPY_TO_S3=false
